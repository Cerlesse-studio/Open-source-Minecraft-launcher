{
  "name": "open-source-minecraft-launcher",
  "private": true,
  "version": "0.1.6",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test src/lib/multiplayerHealth.test.ts src/lib/multiplayerP2p.test.ts src/lib/multiplayerRelay.test.ts src/lib/format.test.ts src/lib/coreResult.test.ts",
    "core:dev": "cargo build --manifest-path src-tauri/Cargo.toml",
    "core:build": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "start": "npm run core:dev && node electron/dev.cjs",
    "electron:dev": "npm run start",
    "electron:build": "npm run core:build && npm run build && electron-builder",
    "electron:build:portable": "npm run core:build && npm run build && electron-builder --win portable",
    "electron:build:nsis": "npm run core:build && npm run build && electron-builder --win nsis",
    "electron:audit": "node electron/measure-baseline.cjs",
    "electron:fuses": "node electron/fuses.cjs",
    "app:build": "npm run electron:build",
    "package": "node scripts/package.mjs",
    "package:win": "node scripts/package.mjs --platform win",
    "package:mac": "node scripts/package.mjs --platform mac",
    "package:linux": "node scripts/package.mjs --platform linux",
    "package:ota": "node scripts/package.mjs --ota-only"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "cross-env": "^7.0.3",
    "electron": "^22.3.27",
    "electron-builder": "^25.1.8",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.opensource.minecraft.launcher",
    "productName": "Open-source-Minecraft-launcher",
    "directories": {
      "output": "release",
      "buildResources": "src-tauri/icons"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/backend-console-preload.cjs",
      "electron/updater.cjs",
      "electron/fuses.cjs",
      "electron/after-pack.cjs",
      "electron/measure-baseline.cjs",
      "electron/chromium/args.gn",
      "package.json",
      "!**/*.map",
      "!**/test/**",
      "!**/docs/**",
      "!node_modules/**/{README,CHANGELOG}*",
      "!node_modules/**/*.md",
      "!node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "compression": "maximum",
    "afterPack": "electron/after-pack.cjs",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "src-tauri/target/release/open-source-minecraft-launcher.exe",
          "to": "core/open-source-minecraft-launcher.exe"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "icon": "src-tauri/icons/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "src-tauri/target/release/open-source-minecraft-launcher",
          "to": "core/open-source-minecraft-launcher"
        }
      ]
    },
    "linux": {
      "icon": "src-tauri/icons/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "AppImage"
      ],
      "extraResources": [
        {
          "from": "src-tauri/target/release/open-source-minecraft-launcher",
          "to": "core/open-source-minecraft-launcher"
        }
      ]
    },
    "nsis": {
      "include": "electron/installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowElevation": true,
      "perMachine": true,
      "differentialPackage": false
    }
  },
  "description": "Open-source-Minecraft-launcher — an open-source Minecraft launcher",
  "author": "Open-source-Minecraft-launcher Team"
}
